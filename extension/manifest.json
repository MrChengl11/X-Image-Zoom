{
  "manifest_version": 3,
  "name": "X Pic Zoom",
  "version": "1.0.0",
  "description": "Scroll to zoom photos in the X (Twitter) image viewer. 在 X 图片查看器中滚动滚轮缩放图片。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
